# ============================================================================
# DocMind 环境变量样例 —— 复制为 .env 后填入真实值
#
# 放置位置：仓库根目录（与 docker-compose.yml 同级）
#   - docker compose 默认读取根目录 .env（用于端口等变量替换）
#   - 后端通过 pydantic-settings 的 env_file 指向仓库根 .env
#     （见 backend/app/core/config.py 的 ENV_FILE，单一事实来源，不复制两份）
#   - .env 已被 .gitignore 排除，禁止提交；用 `git check-ignore -v .env` 复核
#
# 三档配置的含义：
#   [必需]   缺失则应用启动失败，并指出缺哪一项
#   [占位]   W5 不参与数据流，缺失只告警不阻断启动
#   [业务]   代码里有默认值（backend/app/core/config.py），此处列出供覆盖
# ============================================================================


# =========================== [必需] 运行环境 ===========================

# PostgreSQL 异步连接串（compose 把 pg 映射到宿主 5433；容器内由 compose 覆盖为 pg:5432）
DATABASE_URL=postgresql+asyncpg://docmind:CHANGE_ME@127.0.0.1:5433/docmind

# Redis（compose 把 redis 映射到宿主 6380；兼作 Celery broker 与结果后端）
REDIS_URL=redis://127.0.0.1:6380/0

# 登录凭证签名密钥，生成方式：
#   openssl rand -hex 32
#   python -c "import secrets;print(secrets.token_hex(32))"
# 务必每个环境不同
SECRET_KEY=CHANGE_ME_openssl_rand_hex_32

# PostgreSQL 容器初始化（compose 使用；三个值需与上面的 DATABASE_URL 保持一致）
POSTGRES_USER=docmind
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=docmind

# 宿主端口映射。本机 8000 / 5432 / 6379 已被既有 OneHub 栈占用，
# 9000-9001 / 9091 / 19530 被既有 Milvus 占用，故错开（详见 docker-compose.yml 抬头注释）
PG_HOST_PORT=5433
REDIS_HOST_PORT=6380
NGINX_HOST_PORT=8080


# ==================== [占位] 模型网关（单一网关） ====================
# 一个 BASE_URL + 一个 API_KEY 同时提供生成 / 嵌入 / 重排。
# 若要换成多家服务商（如 DeepSeek 生成 + 硅基流动嵌入重排），
# 请拆成 *_BASE_URL / *_API_KEY 多组，并在 backend/app/core/config.py 里对应调整。

# OpenAI 兼容入口：/chat/completions 与 /embeddings 都挂在这里
BASE_URL=https://your-gateway.example.com/compatible-mode/v1
API_KEY=sk-CHANGE_ME

# 生成模型（用于回答生成、query 改写、grade 打分、引用校验）
# 注意：deepseek-v4-pro-0813 默认开启思考模式，max_tokens 过小会全被 reasoning 吃掉
#       从而返回空 content；低成本任务可换 deepseek-v4-flash-0731
GENERATIVE_MODEL=deepseek-v4-pro-0813

# 嵌入模型与向量维度
# EMBEDDING_DIM 必须与 Milvus collection 的 FLOAT_VECTOR 维度一致，
# 换嵌入模型时两者必须一起改（属禁改清单，需走 OpenSpec 提案）
EMBEDDING_MODEL=qwen3.7-text-embedding
EMBEDDING_DIM=1024

# 重排模型 + 其专属端点
# 重排不在 /compatible-mode/v1 下（会 404），必须用 DashScope 原生路径：
#   {host}/api/v1/services/rerank/text-rerank/text-rerank
# 请求体：{"model":..., "input":{"query":...,"documents":[...]},
#          "parameters":{"top_n":N,"return_documents":true}}
# 响应体：{"output":{"results":[{"index":N,"relevance_score":0.85,...}]}}
RERANK_MODEL=qwen3.7-text-rerank
RERANK_BASE_URL=https://your-gateway.example.com/api/v1/services/rerank/text-rerank/text-rerank


# ====================== [业务] 存储与上传（5.x） ======================
# 宿主开发默认落在仓库根 uploads/；容器内由 compose 覆盖为共享卷 /data/uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=50
ALLOWED_EXTENSIONS=pdf,docx,md,txt


# ====================== [业务] 分块参数（6.x） ======================
# FR-006 / SC-007：改这两个值即可调整分块粒度与重叠比例，无需改代码
# 注意：重叠使相邻片段共享边界文本，验收按「覆盖性 / 顺序性 / 忠实性」三项判断，
#       不得用"拼接结果等于原文"作为判据（见 design.md D5）
CHUNK_SIZE_TOKENS=512
CHUNK_OVERLAP_TOKENS=64


# =================== [业务] 重试与中断补偿（8.x） ====================
AUTO_RETRY_MAX=2
MANUAL_RETRY_MAX=3
RETRY_BACKOFF_BASE_SECONDS=5
STUCK_TASK_THRESHOLD_SECONDS=600
# beat 心跳周期，容器健康探针据此判断 beat → broker → worker → redis 链路是否连通
BEAT_HEARTBEAT_INTERVAL_SECONDS=30


# ======================== [业务] 鉴权（3.x） =========================
# 密码强度：长度 >= PASSWORD_MIN_LENGTH 且 <= PASSWORD_MAX_LENGTH，并同时包含字母与数字
# 上限属"输入护栏"（别让超长输入白耗 argon2 算力），不是抗爆破旋钮
PASSWORD_MIN_LENGTH=8
PASSWORD_MAX_LENGTH=128
TOKEN_EXPIRE_MINUTES=1440
JWT_ALGORITHM=HS256
